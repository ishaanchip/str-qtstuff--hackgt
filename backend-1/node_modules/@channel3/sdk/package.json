{
    "name": "@channel3/sdk",
    "version": "4.1.0",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/channel3-ai/channel3-ts-sdk.git"
    },
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./serialization": {
            "import": {
                "types": "./dist/esm/serialization/index.d.mts",
                "default": "./dist/esm/serialization/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/serialization/index.d.ts",
                "default": "./dist/cjs/serialization/index.js"
            },
            "default": "./dist/cjs/serialization/index.js"
        },
        "./websites": {
            "import": {
                "types": "./dist/esm/api/resources/websites/exports.d.mts",
                "default": "./dist/esm/api/resources/websites/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/websites/exports.d.ts",
                "default": "./dist/cjs/api/resources/websites/exports.js"
            },
            "default": "./dist/cjs/api/resources/websites/exports.js"
        },
        "./products": {
            "import": {
                "types": "./dist/esm/api/resources/products/exports.d.mts",
                "default": "./dist/esm/api/resources/products/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/products/exports.d.ts",
                "default": "./dist/cjs/api/resources/products/exports.js"
            },
            "default": "./dist/cjs/api/resources/products/exports.js"
        },
        "./reporting": {
            "import": {
                "types": "./dist/esm/api/resources/reporting/exports.d.mts",
                "default": "./dist/esm/api/resources/reporting/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/reporting/exports.d.ts",
                "default": "./dist/cjs/api/resources/reporting/exports.js"
            },
            "default": "./dist/cjs/api/resources/reporting/exports.js"
        },
        "./categories": {
            "import": {
                "types": "./dist/esm/api/resources/categories/exports.d.mts",
                "default": "./dist/esm/api/resources/categories/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/categories/exports.d.ts",
                "default": "./dist/cjs/api/resources/categories/exports.js"
            },
            "default": "./dist/cjs/api/resources/categories/exports.js"
        },
        "./brands": {
            "import": {
                "types": "./dist/esm/api/resources/brands/exports.d.mts",
                "default": "./dist/esm/api/resources/brands/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/brands/exports.d.ts",
                "default": "./dist/cjs/api/resources/brands/exports.js"
            },
            "default": "./dist/cjs/api/resources/brands/exports.js"
        },
        "./conversations": {
            "import": {
                "types": "./dist/esm/api/resources/conversations/exports.d.mts",
                "default": "./dist/esm/api/resources/conversations/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/conversations/exports.d.ts",
                "default": "./dist/cjs/api/resources/conversations/exports.js"
            },
            "default": "./dist/cjs/api/resources/conversations/exports.js"
        },
        "./collections": {
            "import": {
                "types": "./dist/esm/api/resources/collections/exports.d.mts",
                "default": "./dist/esm/api/resources/collections/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/collections/exports.d.ts",
                "default": "./dist/cjs/api/resources/collections/exports.js"
            },
            "default": "./dist/cjs/api/resources/collections/exports.js"
        },
        "./experimental": {
            "import": {
                "types": "./dist/esm/api/resources/experimental/exports.d.mts",
                "default": "./dist/esm/api/resources/experimental/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/experimental/exports.d.ts",
                "default": "./dist/cjs/api/resources/experimental/exports.js"
            },
            "default": "./dist/cjs/api/resources/experimental/exports.js"
        },
        "./priceTracking": {
            "import": {
                "types": "./dist/esm/api/resources/priceTracking/exports.d.mts",
                "default": "./dist/esm/api/resources/priceTracking/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/priceTracking/exports.d.ts",
                "default": "./dist/cjs/api/resources/priceTracking/exports.js"
            },
            "default": "./dist/cjs/api/resources/priceTracking/exports.js"
        },
        "./conversations/clientTokens": {
            "import": {
                "types": "./dist/esm/api/resources/conversations/resources/clientTokens/exports.d.mts",
                "default": "./dist/esm/api/resources/conversations/resources/clientTokens/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/conversations/resources/clientTokens/exports.d.ts",
                "default": "./dist/cjs/api/resources/conversations/resources/clientTokens/exports.js"
            },
            "default": "./dist/cjs/api/resources/conversations/resources/clientTokens/exports.js"
        },
        "./package.json": "./package.json",
        "./resources": {
            "import": {
                "types": "./dist/esm/resources.d.mts",
                "default": "./dist/esm/resources.mjs"
            },
            "require": {
                "types": "./dist/cjs/resources.d.ts",
                "default": "./dist/cjs/resources.js"
            },
            "default": "./dist/cjs/resources.js"
        }
    },
    "files": [
        "dist",
        "reference.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format": "biome format --write --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "format:check": "biome format --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint": "biome lint --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint:fix": "biome lint --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check": "biome check --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check:fix": "biome check --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "build": "pnpm build:cjs && pnpm build:esm",
        "build:cjs": "tsc --project ./tsconfig.cjs.json",
        "build:esm": "tsc --project ./tsconfig.esm.json && node scripts/rename-to-esm-files.js dist/esm",
        "test": "vitest",
        "test:unit": "vitest --project unit",
        "test:wire": "vitest --project wire"
    },
    "dependencies": {},
    "devDependencies": {
        "webpack": "^5.105.4",
        "ts-loader": "^9.5.4",
        "vitest": "^4.1.1",
        "vite": "^8.0.16",
        "msw": "2.11.2",
        "@types/node": "^20.0.0",
        "typescript": "~5.9.3",
        "@biomejs/biome": "2.4.10"
    },
    "browser": {
        "fs": false,
        "os": false,
        "path": false,
        "stream": false,
        "crypto": false
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": false
}
