import type * as Channel3Api from "../index.mjs";
/**
 * One value of one variant option (e.g. 'Blue' under 'Color')
 */
export interface OptionValue {
    /** The display value of the option value (e.g. 'Blue') */
    label: string;
    /** Whether the option value exists on the product, or is a configuration only present on another variant of the same product. For example, a shirt that comes in multiple colors, but only one color is available in Size XL. */
    exists: boolean;
    /** The availability status of the option value. None when returned on search results, hydrated only on get product detail requests. */
    available?: Channel3Api.OfferAvailabilityStatus | null;
    /** For options that reference different products, this is the URL of the thumbnail image for the option value. E.g., a shoe that comes in multiple colors will have an OptionValue for each color with a thumbnail_url set. */
    thumbnail_url?: string | null;
    /** The product id that represents this value. Variants that point to different products will have this field set, as well as thumbnail_url for displaying selector icons. */
    product_id?: string | null;
}
