/**
 * Persisted clause with a stable server-minted id.
 */
export interface CollectionClause {
    /** OR within this list (any slot). AND with the clause's other lists. OR against other clauses. */
    brand_ids?: string[] | null;
    /** Merchant ids; OR within this list (any matching offer). AND with the clause's other lists. Domains are accepted on write and stored as merchant ids. */
    website_ids?: string[] | null;
    /** OR within this list. AND with the clause's other lists. */
    category_ids?: string[] | null;
    product_ids?: string[] | null;
    clause_id: string;
}
