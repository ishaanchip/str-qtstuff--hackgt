import type * as Channel3Api from "../index.mjs";
/**
 * Thread metadata plus one page of its message history.
 */
export interface ConversationDetail {
    id: string;
    created_at: number;
    user_id?: string | null;
    context?: Channel3Api.ConversationContext | null;
    items: Channel3Api.ConversationDetailItemsItem[];
    /** Pass as ``cursor`` to fetch the next page. Null when no more items. */
    next_cursor?: string | null;
    has_more?: boolean;
}
