import type * as Channel3Api from "../index.mjs";
/**
 * Shared request config: locale plus optional collection scope.
 */
export interface BaseConfig {
    /** ISO 639-1 language code. When unset, inferred from ``country`` (preferred) then ``currency``, defaulting to ``en``. */
    language?: Channel3Api.LanguageCode | null;
    /** ISO 3166-1 alpha-2 country code. May stay unset for pan-region storefronts (e.g. ``currency=EUR`` with no specific country). */
    country?: Channel3Api.CountryCode | null;
    /** ISO 4217 currency code. When unset, inferred from ``country`` (e.g. ``GB`` → ``GBP``), defaulting to ``USD``. */
    currency?: Channel3Api.CurrencyCode | null;
    /** Preferred unit for length dimensions (length/width/height) in responses. A request dimension filter's unit for the field takes precedence; when neither is set, the merchant's stated unit is returned. */
    length_unit?: Channel3Api.LengthUnit | null;
    /** Preferred unit for weight dimensions in responses. A request dimension filter's weight unit takes precedence; when neither is set, the merchant's stated unit is returned. */
    weight_unit?: Channel3Api.WeightUnit | null;
    /** Optional saved collection to scope this request. Clauses are ORed. Within a clause, brand/website/category lists are ORed inside each list and ANDed across lists. Request filters further narrow results but cannot widen the collection scope. */
    collection_id?: string | null;
}
