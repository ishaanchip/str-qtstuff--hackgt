import type * as Channel3Api from "../index.mjs";
/**
 * Full category representation used in detail responses.
 */
export interface Category {
    /** URL-friendly slug (e.g. 'sofas') */
    slug: string;
    /** Human-readable category title */
    title: string;
    /** Hierarchical path as a structured list, root first; the last entry is this category itself */
    path?: Channel3Api.CategoryRef[];
    /** Whether this category has subcategories */
    has_children: boolean;
    /** Natural-language description of products in this category */
    description?: string | null;
    /** Direct subcategories only (one level) */
    children?: Channel3Api.CategoryRef[];
    /** Structured attributes applicable to this category, with their allowed values. Usable as keys in `SearchFilters.attributes`. Includes the variant axes ('color', 'size', 'shoe-size') where the category defines them; those match against each offer's variant options. */
    attributes?: Channel3Api.CategoryAttribute[];
}
