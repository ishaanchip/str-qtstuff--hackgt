import type * as Channel3Api from "../../../../index.mjs";
/**
 * @example
 *     {
 *         product_id: "product_id"
 *     }
 */
export interface SimilarProductsRequest {
    /** Optional user identifier to attribute clicks and sales to a user in your system. Channel3 appends it to buy URLs in the response. */
    "x-user-id"?: string | null;
    /** Canonical product ID to find similar products for. */
    product_id: string;
    /** Optional limit on the number of results. Default is 20, max is 30. */
    limit?: number | null;
    /** Optional filters. Search will only consider products that match all of the filters. */
    filters?: Channel3Api.SearchFilters;
    /** Optional configuration. */
    config?: Channel3Api.BaseConfig;
    /** Opaque token from a previous similar response to fetch the next page of results. */
    page_token?: string | null;
}
